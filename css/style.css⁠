@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap');
@import url('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');

:root {
    --primary-red: #8B0000;  
    --gold-accent: #D4AF37;  
    --bg-orange-light: #FDF5E6; /* Nền cam nhẹ sang trọng */
    --text-dark: #3A2E2B;    
}

* {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
}

body {
    background-color: #E6E6FA; /* Nền ngoài cho máy tính */
    color: var(--text-dark);
    margin: 0;
    font-family: 'Lora', serif;
    line-height: 1.8;
}

/* Khung chuẩn chống vỡ giao diện trên máy tính */
#main-content {
    background-color: var(--bg-orange-light);
    max-width: 500px;
    margin: 0 auto;
    box-shadow: 0 0 40px rgba(0,0,0,0.15);
    min-height: 100vh;
    position: relative;
    padding-bottom: 30px;
    overflow-x: hidden;
}

/* --- THIẾT KẾ BÌA ĐẦU TIÊN (HERO) GIỐNG ẢNH MẪU --- */
.hero-top-arch {
    background-color: var(--primary-red);
    border-bottom-left-radius: 50% 15%;
    border-bottom-right-radius: 50% 15%;
    padding: 40px 20px 100px 20px;
    text-align: center;
    color: #fff;
}

.hero-img-wrapper {
    text-align: center;
    margin-top: -80px; /* Kéo ảnh trồi lên phần nền đỏ */
    padding: 0 20px;
}

.hero-img-wrapper img {
    width: 260px;
    height: 360px;
    object-fit: cover;
    border-radius: 130px 130px 0 0; /* Bo tròn nửa trên thành hình vòm */
    border: 4px solid var(--bg-orange-light);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

/* --- TIÊU ĐỀ KHỐI NGANG MÀU ĐỎ CHUẨN VIDEO --- */
.section-block-header {
    background-color: var(--primary-red);
    color: var(--gold-accent);
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 12px 0;
    margin: 40px 0 20px 0;
    text-transform: uppercase;
}

/* --- ALBUM ẢNH SWIPER ĐÃ FIX KÍCH THƯỚC --- */
.swiper { 
    width: 100%; 
    padding: 20px 0 50px 0; 
}
.swiper-slide { 
    width: 240px; /* Thu nhỏ chiều rộng để ảnh không bị zoom */
    height: 340px; 
    border-radius: 10px;
    box-shadow: 0 8px 15px rgba(0,0,0,0.15);
    background-color: #fff;
}
.swiper-slide img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    border-radius: 10px; 
}
.swiper-pagination-bullet-active { 
    background: var(--primary-red) !important; 
}

/* Định dạng nội dung chung */
.card-premium {
    padding: 10px 20px;
    text-align: center;
}

.btn-premium {
    background-color: var(--primary-red);
    color: #ffffff;
    font-family: 'Cinzel', serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 12px 30px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}

/* Khung comment Facebook style */
.fb-comment-box {
    background: #fff;
    border: 1px solid #e9ebee;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 10px;
    text-align: left;
}
.fb-author { font-weight: bold; color: var(--primary-red); font-size: 14px; margin-bottom: 2px; }
.fb-text { color: #333; font-size: 14px; }
