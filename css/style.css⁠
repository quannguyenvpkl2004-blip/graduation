/* ==========================================
   BIẾN TOÀN CỤC (CSS VARIABLES) - TONE MÀU LUXURY
   ========================================== */
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Montserrat:wght@300;400;500&display=swap');

:root {
    /* Colors */
    --color-black: #050505;
    --color-black-light: #111111;
    --color-gold: #D4AF37; /* Vàng Gold Sang Trọng */
    --color-gold-light: #F3E5AB;
    --color-red: #8A0303; /* Đỏ đun/Burgundy cao cấp */
    --color-white: #FFFFFF;
    --color-text-light: #CCCCCC;
    :root {
    --primary-red: #8B0000; /* Đỏ đun sang trọng */
    --bg-cream: #FDFBF7;    /* Nền kem nhạt */
    --text-color: #4A3728;  /* Màu nâu đậm cho chữ */
}

body {
    background-color: var(--bg-cream);
    color: var(--text-color);
    font-family: 'Playfair Display', serif; /* Font có chân sang trọng */
}

/* Thanh tiêu đề đặc trưng */
.section-header {
    background-color: var(--primary-red);
    color: white;
    padding: 15px;
    text-align: center;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 30px 0;
}


    /* Glassmorphism */
    --glass-bg: rgba(25, 25, 25, 0.4);
    --glass-border: rgba(212, 175, 55, 0.15);
    --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
    --glass-blur: blur(10px);

    /* Fonts */
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
}

/* ==========================================
   RESET & CƠ BẢN
   ========================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    min-height: 100vh;
    background-color: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-body);
    overflow-x: hidden;
    scroll-behavior: smooth;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-gold);
    font-weight: 600;
    letter-spacing: 1px;
}

a {
    text-decoration: none;
    color: inherit;
}

/* ==========================================
   HIỆU ỨNG KÍNH MỜ (GLASSMORPHISM)
   ========================================== */
.glass-box {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur); /* Hỗ trợ Safari */
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: 16px;
}

/* ==========================================
   BỐ CỤC CHÍNH (MAIN LAYOUT)
   ========================================== */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

section {
    padding: 80px 0;
    position: relative;
}

/* ==========================================
   NÚT BẤM (BUTTONS) & HIỆU ỨNG NỀN
   ========================================== */
.btn {
    display: inline-block;
    padding: 12px 28px;
    background: linear-gradient(135deg, var(--color-gold), #aa8929);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
}

.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(138, 3, 3, 0.15) 0%, rgba(5, 5, 5, 1) 70%);
    z-index: -1;
    /* Style cho các phần tử mới */
.gold-title { color: #8B0000; font-family: 'Playfair Display', serif; }

/* Nút bấm sang trọng */
button:hover { background-color: #6B0F1A !important; transition: 0.3s; }

/* Làm khung sổ lưu bút nổi bật */
#guestbook {
    border-top: 1px solid #E0D0C0;
    margin-top: 40px;
}
 