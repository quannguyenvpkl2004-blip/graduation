/* Nhúng phông chữ cao cấp từ Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap');

:root {
    --primary-red: #6B0F1A;  /* Đỏ rượu chát/đỏ đun sang trọng */
    --gold-accent: #D4AF37;  /* Vàng gold điểm nhấn */
    --bg-cream: #FDFBF7;     /* Nền kem nhã nhặn như giấy mỹ thuật */
    --text-dark: #3A2E2B;    /* Nâu đen ấm áp giúp chữ sang hơn màu đen tuyền */
}

* {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
}

body {
    background-color: var(--bg-cream);
    color: var(--text-dark);
    margin: 0;
    font-family: 'Lora', serif;
    line-height: 1.8;
    overflow-x: hidden;
}

/* Định dạng tiêu đề */
h1, h2, h3, .title-premium {
    font-family: 'Cinzel', serif;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--primary-red);
}

/* Hiệu ứng dải ruy-băng đỏ ngăn cách các phần giống video */
.section-header-ribbon {
    background-color: var(--primary-red);
    color: #ffffff;
    padding: 15px 20px;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 3px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    margin: 40px 0 20px 0;
}

/* Nút bấm sang trọng */
.btn-premium {
    background-color: var(--primary-red);
    color: #ffffff;
    font-family: 'Cinzel', serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    padding: 12px 35px;
    border: 1px solid var(--gold-accent);
    border-radius: 25px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(107, 15, 26, 0.2);
    transition: all 0.4s ease;
}

.btn-premium:hover {
    background-color: #ffffff;
    color: var(--primary-red);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(107, 15, 26, 0.3);
}

/* Ô nhập liệu của lưu bút */
.input-premium {
    width: 100%;
    padding: 12px 15px;
    margin-bottom: 15px;
    border: 1px solid rgba(107, 15, 26, 0.3);
    border-radius: 8px;
    background-color: #ffffff;
    font-family: 'Lora', serif;
    color: var(--text-dark);
    font-size: 15px;
    transition: border 0.3s;
}

.input-premium:focus {
    outline: none;
    border-color: var(--primary-red);
}

/* Đổ bóng nhẹ cho khung nội dung giống video */
.card-premium {
    background: #ffffff;
    padding: 30px 20px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(74, 55, 40, 0.05);
    border: 1px solid rgba(107, 15, 26, 0.05);
}
